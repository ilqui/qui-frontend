{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

# Intestazioni di ogni risposta, comprese le risposte d'errore: una sola sede
(intestazioni) {
	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		Cache-Control "no-cache"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# Indirizzo dell'API: variabile API_URL del servizio su Railway
	handle /config.js {
		header Content-Type "text/javascript; charset=utf-8"
		respond `window.QUI_API = "{$API_URL}";` 200
	}

	# Pagine degli annunci: le costruisce qui-backend, si vedono su www.ilqui.com
	reverse_proxy /l/* qui-backend.railway.internal:8080

	import intestazioni

	root * .

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html

	# Risposte d'errore: Caddy non vi applica le intestazioni differite del sito, quindi si importano qui
	handle_errors {
		import intestazioni
		respond "errore {err.status_code}" {err.status_code}
	}
}
